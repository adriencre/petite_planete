[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/lueurs/compteur.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://assets/lueurs/habitant.tscn" id="2_habitant"]
[ext_resource type="Script" path="res://scripts/lueurs/lueur_speech.gd" id="3_speech"]

[node name="Compteur" type="Node3D"]
