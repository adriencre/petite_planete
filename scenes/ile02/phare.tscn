[node name="Page1" type="Node3D" parent="DocumentsBureau"]
position = Vector3(-1.23, 5.489, -0.89)
script = ExtResource("3_page")
texte = "Tournée du Phare, jour 112.\n\nPour les nouveaux, puisque personne ne lit les consignes : le Phare ne fait pas de lumière. Il la rassemble. Les trois caps la lui renvoient, quand les miroirs sont bien tournés. Si un seul cap s'éteint, la lentille ne voit rien.\n\nJ'ai nettoyé les vitres du Cap Est. Le miroir du Large a encore bougé avec la tempête. N'allez jamais au Large à marée montante : la mer ne prévient pas.\n\nRappel : on ne reprend pas la lumière devant les arbres roses. Ils ne le supportent pas."
signature = "G."
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.45, 0.30)

[node name="RelevesIris" type="Node3D" parent="DocumentsBureau"]
position = Vector3(-0.35, 5.489, -0.91)
script = ExtResource("3_page")
texte = "Plan des miroirs : Cap Est → Cap du Large. Le reste du tracé est effacé.\n\nBasse mer : six tours du faisceau. Pas un de plus.\nPleine lune : plus bas que tout. Le vieux port respire."
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.52, 0.33)
ramasser = false
image = ExtResource("4_releves")

[node name="NoteDeLaCle" type="Node3D" parent="DocumentsBureau"]
position = Vector3(0.43, 5.489, -0.75)
script = ExtResource("3_page")
texte = "J'ai laissé la clé de la salle des cartes dans la cabine, à bord du ravitailleur. Je la reprendrai à la prochaine basse mer. Pas sans le Phare : la brume du large y est trop épaisse.\n\n[i]Les nuits de pleine lune, le Phare chante, et je vois ma maison.[/i]"
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.44, 0.28)
ramasser = false

[node name="DessinDAube" type="Node3D" parent="DocumentsBureau"]
position = Vector3(3.68, 5.84, 1.183)
rotation = Vector3(1.570796, 0, 0)
script = ExtResource("3_page")
texte = "Pour Iris. Ma cachette, c'est par le toit."
distance_lecture = 1.15
hauteur_lecture = 1.96
taille_feuille = Vector2(0.30, 0.24)
ramasser = false

[node name="DocumentsCartes" type="Node3D" parent="."]

[node name="RegistreDesLanternes" type="Node3D" parent="DocumentsCartes"]
position = Vector3(0, 10.208, 0.71)
script = ExtResource("3_page")
texte = "Registre des lanternes\n\nRéveil : l'abri, la veilleuse, le sommet. Rien à signaler. Le jardinier dort.\n\nColonie : 40… 90… 160… 310.\n\nÎle blanche : on m'en demande encore. Ils disent que c'est pour soigner. Je n'y crois plus.\n\nNef : aucune, en attendant le départ.\n\nCentrale : ne pas toucher. Tavin s'en occupe.\n\n⌂"
distance_lecture = 1.35
hauteur_lecture = 1.75
taille_feuille = Vector2(0.71, 0.49)
ramasser = false
