[node name="Page1" type="Node3D" parent="DocumentsBureau"]
position = Vector3(-1.23, 5.489, -0.89)
script = ExtResource("3_page")
texte = "Tournée du Phare, jour 112.\n\nPour les nouveaux, puisque personne ne lit les consignes : la lanterne du cap Est donne toute la lumière. Le premier miroir l'envoie vers le Large. Si une glace dévie, le rayon se perd avant d'atteindre le Phare.\n\nJ'ai nettoyé les vitres du Cap Est. Le miroir du Large a encore bougé avec la tempête. N'allez jamais au Large à marée montante : la mer ne prévient pas.\n\nRappel : on ne reprend pas la lumière devant les arbres roses. Ils ne le supportent pas."
texte_ancien = "Tournée du Phare, jour 112.\n\nPour les nouveaux, puisque personne ne lit les consignes : le Phare ne fait pas de lumière. Il la rassemble. Les trois caps la lui renvoient, quand les miroirs sont bien tournés. Si un seul cap s'éteint, la lentille ne voit rien.\n\nJ'ai nettoyé les vitres du Cap Est. Le miroir du Large a encore bougé avec la tempête. N'allez jamais au Large à marée montante : la mer ne prévient pas.\n\nRappel : on ne reprend pas la lumière devant les arbres roses. Ils ne le supportent pas."
signature = "G."
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.31, 0.41)
image = ExtResource("tournee")
garder_cle_sans_image = true

[node name="RelevesIris" type="Node3D" parent="DocumentsBureau"]
position = Vector3(-0.35, 5.489, -0.91)
script = ExtResource("3_page")
texte = "Plan des miroirs : Cap Est → Cap du Large. Le reste du tracé est effacé.\n\nBasse mer : six tours du faisceau. Pas un de plus.\nPleine lune : plus bas que tout. Le vieux port respire."
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.52, 0.33)
ramasser = false
image = ExtResource("4_releves")

[node name="NoteDeLaCle" type="Node3D" parent="DocumentsBureau"]
position = Vector3(0.43, 5.489, -0.75)
script = ExtResource("3_page")
texte = "J'ai laissé la clé de la salle des cartes dans la cabine, à bord du ravitailleur. Je la reprendrai à la prochaine basse mer. Pas sans le Phare : la brume du large y est trop épaisse.\n\n[i]Les nuits de pleine lune, le Phare chante, et je vois ma maison.[/i]"
distance_lecture = 1.85
hauteur_lecture = 1.92
taille_feuille = Vector2(0.43, 0.295)
image = ExtResource("billet")
garder_cle_sans_image = true
ramasser = false

