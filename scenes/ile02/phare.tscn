[node name="RegistreDesLanternes" type="Node3D" parent="DocumentsCartes"]
position = Vector3(-0.1597, 10.172, 0.6918)
rotation = Vector3(0, -0.226893, 0)
script = ExtResource("3_page")
texte = "Registre des lanternes\n\nRéveil : l'abri, la veilleuse, le sommet. Rien à signaler. Le jardinier dort.\n\nColonie : 40… 90… 160… 310.\n\nÎle blanche : on m'en demande encore. Ils disent que c'est pour soigner. Je n'y crois plus.\n\nNef : aucune, en attendant le départ.\n\nCentrale : ne pas toucher. Tavin s'en occupe.\n\n⌂"
distance_lecture = 1.35
hauteur_lecture = 1.75
taille_feuille = Vector2(0.73, 0.49)
image = ExtResource("registre")
garder_cle_sans_image = true
ramasser = false


[node name="DocumentsChambre" type="Node3D" parent="."]
visible = false

[node name="LettreAYsolde" type="Node3D" parent="DocumentsChambre"]
position = Vector3(8.85, 4.807, -2.28)
script = ExtResource("3_page")
texte = "Ysolde,\n\nTu me demandes encore des lanternes pour l'île blanche. Je ne les poserai pas.\n\nJ'ai vu ce qu'elles font là-bas. Demande à Saule ce qu'elle a vu, elle.\n\nÉteins une seule nuit, avec moi. Une seule. Tu verras ce que je vois."
signature = "Iris"
distance_lecture = 1.28
hauteur_lecture = 1.20
taille_feuille = Vector2(0.28, 0.333)
image = ExtResource("lettre")

