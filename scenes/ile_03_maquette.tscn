script = ExtResource("jh_page")
texte = "Dans la corbeille d'Ysolde, trois billets froissés de l'ingénieur Tavin :

« Commandante, la centrale ne tiendra pas une saison de plus à ce régime. »
« Chaque lanterne que nous ajoutons, la brume semble la sentir. Elle s'épaissit autour. »
« Le berceau du jardinier a sa propre ligne. Quoi qu'il arrive, il tiendra. »"
distance_lecture = 1.5
hauteur_lecture = 1.6
