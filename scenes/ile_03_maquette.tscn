[node name="PlanArchipel" type="Node3D" parent="." unique_id=64585689]
transform = Transform3D(-0.21228, -0.97721, 0, 0, 0, -1, 0.97721, -0.21228, 0, 51.396, 8.83, 10.449)
script = ExtResource("jh_page")
texte = "Au mur de la salle du conseil, le plan de l'archipel des Semeurs. Les îles ont leur nom : la Colonie, le Phare, l'île blanche, la Nef, la Centrale, l'île du Réveil. Au nord-ouest, une petite tache d'encre, là où il n'y a rien."
