[sub_resource type="Resource" id="Dlg_ancienne_1"]
script = ExtResource("om_1")
id = &"ancienne_1"
lines = PackedStringArray("Tu restes éteint. C'est bien, Petit-Jour.", "Avant les Soleils-Fixes, toute l'île était à nous. La place, les champs, les hauts.", "Chaque fois que tu allumes, une maison tombe en cendre. Rallume, et regarde.")
paroles = Array[StringName]([&"anc_eteint", &"anc_avant", &"anc_cendre"])
forbids = Array[StringName]([&"bascule"])
once = true
sets_flag = &"sait_cicatrices"

[sub_resource type="Resource" id="Dlg_ancienne_2"]
script = ExtResource("om_1")
id = &"ancienne_2"
lines = PackedStringArray("Ceux d'avant, les Grands-Aveugles, ne voyaient rien.", "Alors ils ont tout allumé. Le jour ne finissait plus.", "Celle-qui-a-soufflé, elle, voyait. Elle est partie vers le nord, de l'autre côté de l'eau.")
paroles = Array[StringName]([&"anc_aveugles", &"", &"anc_nord"])
forbids = Array[StringName]([&"bascule"])

[sub_resource type="Resource" id="Dlg_ancienne_3"]
script = ExtResource("om_1")
id = &"ancienne_3"
lines = PackedStringArray("Celui-qui-revient… Tu as éteint ta lumière pour de bon.", "Les petites ont besoin de sortir de la Bouche. La veilleuse de la porte brûle leur seuil.", "Reprends sa lumière, et reste dans le noir : elles te suivront jusqu'aux pins.")
paroles = Array[StringName]([&"anc_revient", &"anc_veilleuse", &""])
requires = Array[StringName]([&"bascule"])
forbids = Array[StringName]([&"pouponniere_libre"])

[sub_resource type="Resource" id="Dlg_ancienne_4"]
script = ExtResource("om_1")
id = &"ancienne_4"
lines = PackedStringArray("Les petites ont vu les pins. Le village respire.", "Il reste d'autres îles, d'autres peuples. Ils ont peur, comme nous avions peur.")
paroles = Array[StringName]([&"anc_respire", &""])
requires = Array[StringName]([&"pouponniere_libre"])

[sub_resource type="Resource" id="Dlg_pecheur_1"]
script = ExtResource("om_1")
id = &"pecheur_1"
lines = PackedStringArray("Tu tombes toujours au même endroit. Près de l'eau, à la crique.", "Le vieux Compteur garde une pierre pour chaque fois.", "Moi, je repêche ce que la mer rapporte. Une barque, un jour. Je l'ai cachée sous les racines, à l'ouest.")
paroles = Array[StringName]([&"pech_crique", &"", &"pech_barque"])
once = true
sets_flag = &"indice_barque"

[sub_resource type="Resource" id="Dlg_pecheur_2"]
script = ExtResource("om_1")
id = &"pecheur_2"
lines = PackedStringArray("Mon frère guette sur l'îlot de corail, au bout du ponton.", "Le pont ne se voit que la nuit. Ne rallume pas au milieu : il n'aime pas ça.")
paroles = Array[StringName]([&"pech_ilot", &""])
requires = Array[StringName]([&"dlg_pecheur_1"])
sets_flag = &"indice_ilot"

[sub_resource type="Resource" id="Dlg_jardiniere_1"]
script = ExtResource("om_1")
id = &"jardiniere_1"
lines = PackedStringArray("Ce qui pousse dans le noir éclaire juste assez.", "Les grands champignons tiennent la falaise. La nuit, leurs racines font des marches.", "Mais toi, avec ta lumière, tu n'y vois que des cailloux.")
paroles = Array[StringName]([&"jard_noir", &"jard_marches", &""])
sets_flag = &"indice_racines"

[sub_resource type="Resource" id="Dlg_tisserand_1"]
script = ExtResource("om_1")
id = &"tisserand_1"
lines = PackedStringArray("Chaque maison, je la retisse fil à fil.", "Quand un Soleil-Fixe s'allume, tout brûle en un instant. Pour retisser, il me faut des nuits.", "Si tu reprends la lumière d'une lanterne, je recommence. C'est long. Mais je recommence.")
paroles = Array[StringName]([&"tiss_fil", &"tiss_brule", &"tiss_recommence"])
sets_flag = &"sait_retisser"

[sub_resource type="Resource" id="Dlg_marchande_1"]
script = ExtResource("om_1")
id = &"marchande_1"
lines = PackedStringArray("Tu vois la grande lanterne, au milieu ? Avant, c'était notre fontaine.", "Le jour où on l'allume, toute la place brûle. Les étals, les maisons, tout.", "Alors on vend vite, tant qu'il fait noir.")
paroles = Array[StringName]([&"march_fontaine", &"march_place", &""])
sets_flag = &"sait_grande_lanterne"

[sub_resource type="Resource" id="Dlg_paysan_1"]
script = ExtResource("om_1")
id = &"paysan_1"
lines = PackedStringArray("Nos champs ne poussent que la nuit. Le jour, ils dorment sous la terre.", "Les deux Soleils du sud brûlent tout ce qui dépasse.", "Si tu les allumes, on recommencera. On recommence toujours.")
paroles = Array[StringName]([&"pays_nuit", &"pays_soleils", &""])
sets_flag = &"sait_champs"

[sub_resource type="Resource" id="Dlg_pecheuse_1"]
script = ExtResource("om_1")
id = &"pecheuse_1"
lines = PackedStringArray("De ce côté, le soleil se levait. Avant les Soleils-Fixes, c'était la seule lumière qu'on aimait.", "La cascade, là-haut, cache quelque chose. Les Grands-Aveugles y gardaient leurs papiers.")
paroles = Array[StringName]([&"levant_soleil", &"levant_cascade"])
sets_flag = &"indice_cascade_levant"

[sub_resource type="Resource" id="Dlg_gardien_hauts_1"]
script = ExtResource("om_1")
id = &"gardien_hauts_1"
lines = PackedStringArray("Ici, en haut, on voit venir la lumière avant tout le monde.", "Le Soleil du sommet est le plus vieux. C'est lui qui a chassé nos grands-parents.")
paroles = Array[StringName]([&"hauts_voir", &"hauts_sommet"])
sets_flag = &"sait_sommet"

[sub_resource type="Resource" id="Dlg_veilleur_1"]
script = ExtResource("om_1")
id = &"veilleur_1"
lines = PackedStringArray("Tu as monté les marches des géants. Peu de Petit-Jour savent qu'elles existent.", "D'ici, on voit toute la ville. Et les Soleils-Fixes qui la mangent.", "Celui du sommet est le pire. Quand il brûle, sa lumière descend jusqu'à la mer.")
paroles = Array[StringName]([&"veil_marches", &"", &"veil_sommet"])
sets_flag = &"vu_belvedere"

[sub_resource type="Resource" id="Dlg_guetteur_1"]
script = ExtResource("om_1")
id = &"guetteur_1"
lines = PackedStringArray("Tu as marché sur l'eau, Petit-Jour. Le pont n'est là que pour ceux qui voient la nuit.", "De mon île, je vois le Phare. Ils sont là-bas aussi, sous la brume.", "Ceux du Phare n'ont pas d'yeux. Ils écoutent. Si tu vas les voir, va doucement. Et éteint.")
paroles = Array[StringName]([&"guet_pont", &"guet_phare", &"guet_doucement"])
sets_flag = &"indice_phare"

[sub_resource type="Resource" id="Dlg_enfant_1"]
script = ExtResource("om_1")
id = &"enfant_1"
lines = PackedStringArray("Tu ne m'as pas brûlé.", "Il y a un endroit secret derrière l'eau qui tombe. On n'y va que quand tout est éteint.")
paroles = Array[StringName]([&"enf_brule", &"enf_secret"])
requires = Array[StringName]([&"first_bribe"])
sets_flag = &"indice_cascade"

